# Root configuration file for KubenAI stack
# Copy this file to .env and update with your values

# ===================================
# AI Provider Configuration
# ===================================
# Choose which AI provider to use: "azure" or "digitalocean"
AI_PROVIDER=digitalocean

# ===================================
# DigitalOcean AI Configuration
# ===================================
# Your DigitalOcean API endpoint (do NOT include /chat/completions)
DIGITALOCEAN_INFERENCE_ENDPOINT=https://inference.do-ai.run/v1
# Your DigitalOcean API key (with 'Bearer ' prefix)
DIGITALOCEAN_API_KEY=Bearer your-do-api-key-here
# The model to use with DigitalOcean
DIGITALOCEAN_MODEL=openai-gpt-oss-120b

# ===================================
# Azure OpenAI Configuration
# ===================================
# Only needed if AI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_MODEL=gpt-4
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===================================
# API Service Configuration
# ===================================
API_HOST=0.0.0.0
API_PORT=8000

# ===================================
# UI Service Configuration
# ===================================
# Communication between UI and API service
USE_LOCAL_API=true
LOCAL_CHAT_API_BASE_URL=http://api:8000
LOCAL_CHAT_API_ENDPOINT=/api/chat

# ===================================
# System Configuration
# ===================================
# Default system prompt for the AI
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant.

# CORS settings (comma-separated for multiple origins)
CORS_ORIGINS=*

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
